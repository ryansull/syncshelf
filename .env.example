# SyncShelf environment template
#
# Copy to .env in the repo root (git-ignored) and fill in real values there:
#   cp .env.example .env
#
# Never commit real values, and never paste them into chat or GitHub issues.
# Placeholders follow the repo conventions: *.home.arpa for LAN hosts,
# example.com for public hosts, ALICE/BOB for profile names.
#
# Multiple users: shared services get one key; anything personal gets one key
# per person, suffixed with that person's profile name (rename ALICE/BOB to
# your own). profiles.yaml refers to each secret by its variable name,
# e.g.  hardcover_token: ${HARDCOVER_TOKEN_ALICE}
#
# Only secret keys expand ${VAR}. Every other profiles.yaml value, the service
# URLs and Goodreads user ids included, is written there literally. The
# non-secret variables below are for the live tests only; SyncShelf never
# reads them.
#
# For the live API checks during planning (issue #2) only the first person's
# keys are needed; the second person's can be filled in later.

# =============================================================================
# SyncShelf itself
# =============================================================================

# Path to profiles.yaml (copy profiles.example.yaml). Defaults to
# /config/profiles.yaml, the container mount, when unset.
SYNCSHELF_CONFIG=/config/profiles.yaml

# Data directory: the database, its snapshots and goodreads/. Defaults to
# /data, the container volume, when unset. It must already exist. Set it when
# running outside a container, e.g. SYNCSHELF_DATA_DIR=./local/data
SYNCSHELF_DATA_DIR=/data

# Dev mode only (server.auth_mode: dev): the static bearer token a local
# client such as Claude Code or MCP Inspector sends to /mcp.
# Generate with: openssl rand -hex 32
# profiles.yaml: server.dev.token: ${SYNCSHELF_DEV_TOKEN}
SYNCSHELF_DEV_TOKEN=

# OAuth mode only (server.auth_mode: oauth). The Application Audience (AUD)
# tag of the Cloudflare Access app guarding /authorize, from its overview in
# Zero Trust -> Access -> Applications.
# profiles.yaml: server.access.aud: ${ACCESS_AUD}
ACCESS_AUD=
# OAuth mode only: signs the consent form. Generate with: openssl rand -hex 32
# profiles.yaml: server.consent_hmac_key: ${CONSENT_HMAC_KEY}
CONSENT_HMAC_KEY=

# =============================================================================
# Shared: one instance serves everyone
# =============================================================================

# Live tests only: LAN URL reachable from wherever the tests run (never a
# public URL). SyncShelf takes it from services.chaptarr_url in profiles.yaml.
CHAPTARR_URL=http://chaptarr.home.arpa:<port>
# Chaptarr -> Settings -> General -> API Key.
# profiles.yaml: services.chaptarr_api_key: ${CHAPTARR_API_KEY}
CHAPTARR_API_KEY=

# Live tests only. SyncShelf takes it from services.abs_url in profiles.yaml.
ABS_URL=http://audiobookshelf.home.arpa

# =============================================================================
# Per person: ALICE
# =============================================================================

# hardcover.app -> Settings -> API. Paste exactly as shown; note whether it
# already starts with "Bearer ".
HARDCOVER_TOKEN_ALICE=
# This person's ABS API token (each ABS user has their own).
ABS_TOKEN_ALICE=
# Live tests only: the numeric id from the profile URL,
# goodreads.com/user/show/<id>-name. SyncShelf takes it from
# profiles.<name>.goodreads.user_id in profiles.yaml.
GOODREADS_USER_ID_ALICE=
# Email/password sign-in (not Google/Apple).
GOODREADS_EMAIL_ALICE=
GOODREADS_PASSWORD_ALICE=
# Runtime only (phase 1+): secret for the LAN-only CSV upload endpoint.
# Generate with: openssl rand -hex 32
INGEST_SECRET_ALICE=

# =============================================================================
# Per person: BOB (optional during planning)
# =============================================================================

HARDCOVER_TOKEN_BOB=
ABS_TOKEN_BOB=
GOODREADS_USER_ID_BOB=
GOODREADS_EMAIL_BOB=
GOODREADS_PASSWORD_BOB=
INGEST_SECRET_BOB=
