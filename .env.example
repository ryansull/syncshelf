# SyncShelf environment template
#
# Copy to local/.env (git-ignored) and fill in real values there:
#   cp .env.example local/.env
#
# Never commit real values, and never paste them into chat or GitHub issues.
# Placeholders follow the repo conventions: *.home.arpa for LAN hosts,
# example.com for public hosts, ALICE/BOB for profile names.
#
# Multiple users: shared services get one key; anything personal gets one key
# per person, suffixed with that person's profile name (rename ALICE/BOB to
# your own). In phase 1, profiles.yaml maps each person's email to
# their keys by name, e.g.  hardcover_token: ${HARDCOVER_TOKEN_ALICE}
#
# For the live API checks during planning (issue #2) only the first person's
# keys are needed; the second person's can be filled in later.

# =============================================================================
# Shared: one instance serves everyone
# =============================================================================

# LAN URL reachable from wherever the checks run (never a public URL).
CHAPTARR_URL=http://chaptarr.home.arpa:<port>
# Chaptarr -> Settings -> General -> API Key.
CHAPTARR_API_KEY=

ABS_URL=http://audiobookshelf.home.arpa

# =============================================================================
# Per person: ALICE
# =============================================================================

# hardcover.app -> Settings -> API. Paste exactly as shown; note whether it
# already starts with "Bearer ".
HARDCOVER_TOKEN_ALICE=
# This person's ABS API token (each ABS user has their own).
ABS_TOKEN_ALICE=
# Numeric id from the profile URL: goodreads.com/user/show/<id>-name
GOODREADS_USER_ID_ALICE=
# Email/password sign-in (not Google/Apple).
GOODREADS_EMAIL_ALICE=
GOODREADS_PASSWORD_ALICE=
# Runtime only (phase 1+): secret for the LAN-only CSV upload endpoint.
# Generate with: openssl rand -hex 32
INGEST_SECRET_ALICE=

# =============================================================================
# Per person: BOB (optional during planning)
# =============================================================================

HARDCOVER_TOKEN_BOB=
ABS_TOKEN_BOB=
GOODREADS_USER_ID_BOB=
GOODREADS_EMAIL_BOB=
GOODREADS_PASSWORD_BOB=
INGEST_SECRET_BOB=
